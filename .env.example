# Copia este archivo como .env y completa los valores
PORT=3006

# Conexion a MySQL
DB_HOST=localhost
DB_NAME=api-db
DB_USER=root
DB_PASS=

# Usuarios creados por npm run seed (solo para desarrollo local)
ADMIN_EMAIL=admin@inventario.test
ADMIN_PASSWORD=cambia_esta_clave
SEED_ALMACENERO_PASSWORD=cambia_esta_clave

# Autenticacion: genera un valor propio con
# node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Origenes permitidos, separados por coma
CORS_ORIGINS=http://localhost:5173

# Limite de peticiones (ventana de 15 minutos)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_LOGIN_MAX=10
